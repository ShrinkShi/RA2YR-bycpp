# RA2YR compatibility corpus binaries are stored with Git LFS.
# Extension matching is explicitly case-insensitive for legacy Westwood assets.
/CNCRA2YR1.001/corpus/**/*.[mM][iI][xX] filter=lfs diff=lfs merge=lfs -text
/CNCRA2YR1.001/corpus/**/*.[yY][rR][oO] filter=lfs diff=lfs merge=lfs -text
/CNCRA2YR1.001/corpus/**/*.[mM][aA][pP] filter=lfs diff=lfs merge=lfs -text
/CNCRA2YR1.001/corpus/**/*.[sS][hH][pP] filter=lfs diff=lfs merge=lfs -text
/CNCRA2YR1.001/corpus/**/*.[vV][xX][lL] filter=lfs diff=lfs merge=lfs -text
/CNCRA2YR1.001/corpus/**/*.[hH][vV][aA] filter=lfs diff=lfs merge=lfs -text
/CNCRA2YR1.001/corpus/**/*.[tT][mM][pP] filter=lfs diff=lfs merge=lfs -text
/CNCRA2YR1.001/corpus/**/*.[pP][aA][lL] filter=lfs diff=lfs merge=lfs -text
/CNCRA2YR1.001/corpus/**/*.[cC][sS][fF] filter=lfs diff=lfs merge=lfs -text

# Preserve exact legacy INI bytes/line endings in normal Git.
/CNCRA2YR1.001/corpus/**/*.[iI][nN][iI] -text
