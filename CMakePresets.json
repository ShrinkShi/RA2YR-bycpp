{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-vcpkg",
      "displayName": "Windows + vcpkg manifest",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_MODE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-vcpkg-debug", "configurePreset": "windows-vcpkg" }
  ],
  "testPresets": [
    { "name": "windows-vcpkg-debug", "configurePreset": "windows-vcpkg", "output": { "outputOnFailure": true } }
  ]
}
